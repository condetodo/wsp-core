# PLANTILLA de variables de entorno.
# Esta versión SÍ va a Git (no tiene secretos reales).
# Copiá este archivo a ".env" y completá los valores reales ahí.

# Token de la WhatsApp Cloud API (lo da Meta). Por ahora es temporal: vence en 24hs.
WHATSAPP_TOKEN=

# ID del número de teléfono emisor (lo da Meta, en tu panel de la app).
PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA).
WABA_ID=

# ID de la APP de Meta (número largo, en developers.facebook.com → tu app).
# Necesario para crear plantillas con imagen de cabecera (la imagen de ejemplo
# se sube a nivel app vía la Resumable Upload API).
APP_ID=

# Palabra secreta que inventás vos. La usa Meta para verificar el webhook.
VERIFY_TOKEN=

# Clave (la inventás vos) para disparar tareas administrativas por URL,
# como los recordatorios de service: /tareas/recordar-services?key=ESTA_CLAVE
# Si la dejás vacía, esa ruta queda desactivada.
TAREAS_KEY=

# Tu número personal de WhatsApp (destinatario de prueba), formato internacional
# SIN "+", SIN espacios. Ejemplo: 5491122334455
MY_TEST_NUMBER=

# Clave de la API de Anthropic (Claude). Se saca de console.anthropic.com.
ANTHROPIC_API_KEY=

# Conexión a Postgres (memoria persistente: contactos + historial).
# En Railway esta variable la inyecta SOLA el plugin de Postgres (no la toques ahí).
# En local, apuntala a tu propia base, por ejemplo:
#   postgresql://usuario:clave@localhost:5432/wsp
DATABASE_URL=

# WhatsApp del asesor "de guardia" (fallback para el aviso de derivación cuando
# todavía no cargaste asesores con whatsapp en la tabla). Formato sin "+" ni el 9.
ASESOR_WHATSAPP=

# Aviso por mail de los leads calificados (https://resend.com). Si falta la
# clave, el aviso queda desactivado: se loguea y la conversación sigue igual.
RESEND_API_KEY=

# Remitente de esos avisos, formato: Nombre <casilla@tudominio.com>
# El dominio tiene que estar verificado en Resend; si no, sólo se puede enviar
# desde onboarding@resend.dev y sólo a la casilla dueña de la cuenta.
AVISOS_FROM=

# Secreto para firmar la cookie de sesión del panel del asesor (/panel).
# Si no está, el panel queda DESACTIVADO (responde 503). Poné un valor largo y
# aleatorio en Railway. Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_SECRET=
